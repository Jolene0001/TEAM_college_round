{
  "manifest_version": 3,
  "name": "Hands-Free Web Navigator",
  "version": "2.0",
  "description": "Navigate any website hands-free using voice and camera tracking.",
  "permissions": [
    "activeTab",
    "scripting"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "action": {
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_end"
    }
  ]
}
