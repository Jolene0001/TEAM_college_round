{
  "manifest_version": 3,
  "name": "Hands-Free Web Navigator",
  "version": "17.0",
  "description": "Navigate any website completely hands-free using voice and camera tracking.",
  "permissions": [
    "activeTab",
    "scripting",
    "storage"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {},
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_end"
    }
  ]
}




